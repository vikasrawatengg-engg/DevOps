pipeline {
    agent { 
        node { 
            label 'Jenkins-Node-01' 
        } 
    }

    environment {
        // Defines the deployment region context
        AWS_DEFAULT_REGION = 'ap-south-1' 
    }

    stages {
        stage('Git Checkout') {
            steps {
                echo 'Pulling infrastructure configuration blueprints from SCM...'
                git url: 'https://github.com/vikasrawatengg-engg/DevOps.git', branch: 'main'
            }
        }

        stage('Terraform Installation') {
            steps {
                echo 'Verifying and installing Terraform tool binaries...'
                /* Automatically checks if Terraform is available; 
                   if missing, it safely downloads the official HashiCorp repo package. */
                sh '''
                    if ! command -v terraform &> /dev/null; then
                        echo "Terraform missing. Installing packages..."
                        sudo dnf install -y yum-utils
                        sudo yum-config-manager --add-repo https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo
                        sudo dnf install -y terraform
                    else
                        echo "Terraform is already available:"
                        terraform version
                    fi
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                echo 'Initializing backend infrastructure provider plugins...'
                // Navigates to your custom Terraform directory if applicable, or runs locally
                sh 'terraform init'
            }
        }

        stage('Terraform Plan') {
            steps {
                echo 'Generating declarative execution plan matrix...'
                
                // Securely injects masked credentials directly into the workspace shell runtime environment
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Gate: Manual Gate Approval') {
            steps {
                // Pauses execution safely inside the Jenkins UI and blocks subsequent stages until you review
                input message: '⚠️ Review the generated Terraform Plan. Do you approve deploying these changes to AWS?', 
                      ok: 'Approve & Apply Changes'
            }
        }

        stage('Terraform Apply') {
            steps {
                echo 'Executing plan target blueprint modifications on AWS infrastructure...'
                
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    // Executes the predefined cached blueprint directly, guaranteeing zero discrepancies
                    sh 'terraform apply -input=false tfplan'
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up cached workspace plan fragments...'
            sh 'rm -f tfplan'
        }
        success {
            echo '🎉 Infrastructure State Matrix successfully deployed and updated!'
        }
        failure {
            echo '❌ Infrastructure deployment failed. State rolled back securely.'
        }
    }
}