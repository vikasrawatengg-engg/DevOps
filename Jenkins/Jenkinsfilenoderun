pipeline {
    // Directs Jenkins to spin up the build executor on your new machine context
    agent { 
        node { 
            label 'Jenkins-Node-01' 
        } 
    }

    stages {
        stage('Machine Identity Discovery') {
            steps {
                echo 'Verifying deployment context metadata...'
                // Prints worker instance uptime, private network specs, and OS details
                sh 'hostname -I'
                sh 'uptime'
                sh 'uname -a'
            }
        }

        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/jglick/simple-maven-project-with-tests.git', branch: 'master'
            }
        }

        stage('Compile & Package') {
            steps {
                echo 'Compiling codebase via worker binaries...'
                sh 'mvn clean package -DskipTests=true'
            }
        }

        stage('Archive Build Artifacts') {
            steps {
                archiveArtifacts artifacts: '**/target/*.jar', fingerprint: true
            }
        }
    }
}